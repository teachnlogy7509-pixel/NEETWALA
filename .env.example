TELEGRAM_BOT_TOKEN=
# AI provider keys. The bot tries OpenRouter first, then Groq, then Gemini.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# Comma-separated Telegram chat IDs allowed to use admin commands.
ADMIN_CHAT_IDS=
# Optional OpenRouter metadata.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=NEETWALA Knowledge Bot
# Optional: default is data/knowledge_bot.db
DATABASE_PATH=data/knowledge_bot.db
